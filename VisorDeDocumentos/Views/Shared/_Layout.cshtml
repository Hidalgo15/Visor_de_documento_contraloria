<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contraloría General de la República</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">


    <div class="cgr-top-banner p-4 mb-4 d-flex align-items-center">
        <!-- Logo blanco a la izquierda -->
        <div class="me-4 d-none d-md-block">
            <img src="~/images/logo_contraloria_blanco.png" alt="Logo CGR" class="img-fluid" style="max-height: 55px;" />
        </div>

        <!-- Textos institucionales -->
        <div>
            <h5 class="fw-bold mb-1 text-white">Bienvenido al Sistema de Consulta de Certificación de Contratos</h5>
            <p class="mb-0 text-white-50 small">
                Contraloría General de la República. 
            </p>
        </div>
    </div>
    

    <!-- Contenido principal -->
    <main role="main" class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Pie de página -->
    <footer class="text-center py-3 bg-white border-top mt-auto">
        <div class="container">
            <div class="mb-2">
                <img src="~/images/escudobandera.png" alt="Escudo República Dominicana" class="img-fluid" style="max-height: 50px;" />
            </div>
            <small class="text-muted d-block">&copy; @DateTime.Now.Year Contraloría General de la República. Todos los derechos reservados.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>