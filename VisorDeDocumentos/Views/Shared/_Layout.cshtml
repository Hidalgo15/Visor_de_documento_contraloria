<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contraloría General de la República</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar Azul Completa -->
    <header class="navbar-cgr py-3 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">

            <!-- Logo Principal Superior -->
            <div class="logo-container">
                <img src="~/images/logo_contraloria_blanco.png" alt="Contraloría General de la República logo" class="img-fluid" style="max-height: 75px;" />
            </div>

            <!-- Textos en Blanco sobre Azul -->
            <div class="text-end text-white">
                <h5 class="fw-semibold mb-0 text-white">Visor de Certificados de Contrato</h5>
                <small class="text-white-50">Consulta de Certificaciones y Documentos</small>
            </div>

        </div>
    </header>

    <!-- Contenido principal -->
    <main role="main" class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Pie de página con espacio para Logo Secundario -->
    <footer class="text-center py-3 bg-white border-top mt-auto">
        <div class="container">
            <div class="mb-2">
                <!-- Coloca aquí tu segundo logo en wwwroot/images/ -->
                <img src="~/images/escudobandera.png" alt="Logo Institucional Inferior" class="img-fluid" style="max-height: 75px;" />
            </div>
            <small class="text-muted d-block">&copy; @DateTime.Now.Year Todos los derechos reservados.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>