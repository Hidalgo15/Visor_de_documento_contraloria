@model Documento


@{
    ViewData["Title"] = "Consulta";

    string rawPdfUrl = ViewBag.PdfUrl as string ?? "~/pdf/La-Esencia-de-La-Logica.pdf";
    string pdfUrlResolved = Url.Content(rawPdfUrl);

    string noDocumento = ViewBag.NoDocumento as string ?? "6001";
    string? error = ViewBag.Error as string;
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card card-consulta bg-white p-4">

            <!-- Formulario de búsqueda -->
            <div class="mb-4">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="codigo" class="form-label fw-bold">Código del Documento</label>
                        <div class="input-group">
                            <input type="text" 
                                   class="form-control" 
                                   id="codigo" 
                                   name="Codigo" 
                                   placeholder="Ingrese el código del documento (ej: 202608)" 
                                   value="@Model?.Codigo" 
                                   required>
                            <button class="btn btn-primary" type="submit">Consultar</button>
                        </div>
                    </div>
                </form>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-warning border-0 text-center py-3" role="alert" style="background-color: #fcf8e3; color: #8a6d3b;">
                    @error
                </div>
            }
            else if (!string.IsNullOrEmpty(ViewBag.PdfUrl))
            {
                <div class="alert alert-info border-0 d-flex justify-content-between align-items-center mb-3" style="background-color: #d9edf7; color: #31708f;">
                    <div>
                        <span class="fw-bold">Documento Consultado:</span> @noDocumento
                    </div>
                    <span class="badge" style="background-color: #003870;">Documento Oficial</span>
                </div>

                <!-- Visor PDF embebido -->
                <div class="border rounded bg-secondary overflow-hidden" style="height: 75vh;">
                    <iframe src="@pdfUrlResolved" width="100%" height="100%" style="border: none;">
                        Su navegador no soporta la visualización de documentos en formato PDF.
                    </iframe>
                </div>
            }

        </div>
    </div>
</div>