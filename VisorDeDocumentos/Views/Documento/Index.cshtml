@model Documento

@{
    ViewData["Title"] = "Consulta";

    string pdfUrl = ViewBag.PdfUrl as string ?? string.Empty;
    string siteKey = ViewBag.TurnstileSiteKey as string ?? string.Empty;
    string noDocumento = Model?.NoDocumento ?? ViewBag.NoDocumento as string ?? string.Empty;
    string? error = ViewBag.Error as string;
}


<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card card-consulta bg-white p-4">

            <!-- Indicador de documento consultado -->
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <span class="badge" style="background-color: #0d5493;">Certificación Contraloría</span>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-warning border-0 text-center py-3 rounded-3" role="alert" style="background-color: #fcf8e3; color: #8a6d3b;">
                    @error
                </div>
            }
            else if (!string.IsNullOrEmpty(pdfUrl))
            {
                <!-- Desafío Cloudflare Turnstile -->
                <div id="captcha-container" class="d-flex flex-column align-items-center my-4">
                    <p class="text-muted mb-2">Por favor, complete la verificación para visualizar el documento:</p>
                    <div class="cf-turnstile"
                         data-sitekey="@siteKey"
                         data-callback="onTurnstileSuccess"
                         data-expired-callback="onTurnstileExpired"
                         data-error-callback="onTurnstileError">
                    </div>
                </div>

                <!-- Visor PDF embebido (Oculto hasta completar el Turnstile) -->
                <div id="pdf-container" class="cgr-pdf-container overflow-hidden d-none" style="height: 120vh;">
                    <iframe id="pdfIframe" width="100%" height="100%" style="border: none;">
                        Su navegador no soporta la visualización de documentos en formato PDF.
                    </iframe>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <!-- Script Oficial de Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <script>
        const baseUrl = '@pdfUrl';

        // Función ejecutada cuando Turnstile valida exitosamente al usuario
        function onTurnstileSuccess(token) {
            if (!baseUrl) return;

            // Transfiere el token como Query String al endpoint para su validación
            const pdfIframe = document.getElementById('pdfIframe');
            const pdfContainer = document.getElementById('pdf-container');
            const captchaContainer = document.getElementById('captcha-container');

            const separator = baseUrl.includes('?') ? '&' : '?';
            pdfIframe.src = `${baseUrl}${separator}cf-turnstile-response=${encodeURIComponent(token)}`;

            // Oculta el captcha y muestra el iframe
            captchaContainer.classList.add('d-none');
            pdfContainer.classList.remove('d-none');
        }

        function onTurnstileExpired() {
            resetViewer();
            alert("La verificación expiró. Por favor, vuelva a intentarlo.");
        }

        function onTurnstileError() {
            resetViewer();
            alert("Error al cargar la verificación de seguridad. Intente recargar la página.");
        }

        function resetViewer() {
            document.getElementById('pdfIframe').src = '';
            document.getElementById('pdf-container').classList.add('d-none');
            document.getElementById('captcha-container').classList.remove('d-none');
        }
    </script>
}